# Copy to .env.local (gitignored) for local development, and set the same names in
# Cloudflare Pages → Settings → Environment variables. These Firebase web config values
# are public identifiers, not secrets. VITE_RECAPTCHA_SITE_KEY is the reCAPTCHA Enterprise key id.
# Saving turns on only when all five values below are set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
# Local only: 1 = talk to the Firestore emulator on 127.0.0.1:8080 instead of the real project.
VITE_USE_EMULATOR=
