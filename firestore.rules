rules_version = '2';

// GENERATED from firestore.rules.template. Do not edit by hand:
// run `npm run rules:build`, which fills the placeholders from data/schools.json
// and src/logic (school ids, enums, error-report fields and limits).
//
// Model: no login. The browser writes one anonymous submission per browser id,
// create-only error reports, and a +1 help-click counter. Nothing is readable
// except the daily statistics summary (written by the GitHub Action with the Admin SDK).
// App Check enforcement is switched on in the Firebase console, not here.

service cloud.firestore {
  match /databases/{database}/documents {

    function schoolIds() {
      return ['mit', 'princeton', 'harvard', 'yale', 'caltech', 'stanford', 'penn', 'duke', 'jhu', 'northwestern', 'uchicago', 'columbia', 'dartmouth', 'cmu', 'cornell', 'vanderbilt', 'brown', 'rice', 'washu', 'uc-berkeley', 'ucla', 'notre-dame', 'emory', 'georgetown', 'michigan', 'uva', 'unc', 'usc', 'gatech', 'uc-san-diego', 'boston-college', 'nyu', 'tufts', 'bu', 'uc-davis', 'uc-irvine', 'florida', 'uiuc', 'ut-austin', 'wisconsin', 'wake-forest', 'northeastern', 'villanova', 'case-western', 'lehigh', 'ohio-state', 'rutgers', 'uc-santa-barbara', 'maryland', 'rochester', 'uw', 'williams', 'amherst', 'bowdoin', 'claremont-mckenna', 'pomona', 'swarthmore', 'harvey-mudd', 'wellesley', 'vassar', 'washington-and-lee'];
    }

    function isScore(v, lo, hi) {
      return v is int && v >= lo && v <= hi && v % 10 == 0;
    }

    function hasExactly(d, keys) {
      return d.keys().hasAll(keys) && d.keys().hasOnly(keys);
    }

    function validSubmission(d, anonId) {
      return hasExactly(d, ['anonId', 'total', 'rw', 'math', 'attempts', 'grade', 'entryYear',
                            'applicantType', 'country', 'round', 'schools', 'updatedAt'])
        && anonId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
        && d.anonId == anonId
        && isScore(d.total, 400, 1600)
        && isScore(d.rw, 200, 800)
        && isScore(d.math, 200, 800)
        && d.total == d.rw + d.math
        && d.attempts is int && d.attempts >= 1 && d.attempts <= 6
        && d.grade in ['9', '10', '11', '12', 'gap-year']
        && d.entryYear in [2027, 2028, 2029]
        && d.applicantType in ['domestic', 'international']
        && d.round in ['ED', 'EA', 'RD']
        && d.country is string && d.country.matches('^[A-Z]{2}$')
        && d.schools is list
        && d.schools.size() >= 1 && d.schools.size() <= 15
        && d.schools.toSet().size() == d.schools.size()
        && d.schools.hasOnly(schoolIds())
        && d.updatedAt == request.time;
    }

    function validErrorReport(d) {
      return hasExactly(d, ['schoolId', 'field', 'correctValue', 'sourceUrl', 'createdAt'])
        && d.schoolId in schoolIds()
        && d.field in ['Total score range', 'Section score ranges', 'Admit rate', 'Test policy', 'Superscore policy', 'Score sending', 'Deadline', 'Other']
        && d.correctValue is string
        && d.correctValue.size() >= 1 && d.correctValue.size() <= 100
        && d.sourceUrl is string
        && d.sourceUrl.size() <= 300
        && d.sourceUrl.matches('^https://[^\\s]+$')
        && d.createdAt == request.time;
    }

    // One document per browser. Ids are random UUIDs, so they can't be guessed.
    match /submissions/{anonId} {
      allow create, update: if validSubmission(request.resource.data, anonId);
      allow read, delete: if false;
    }

    match /errorReports/{reportId} {
      allow create: if validErrorReport(request.resource.data);
      allow read, update, delete: if false;
    }

    // "Get help" clicks: starts at 1 and can only ever go up by exactly 1.
    match /counters/{name} {
      allow create: if name == 'helpClicks'
        && hasExactly(request.resource.data, ['count', 'updatedAt'])
        && request.resource.data.count == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if name == 'helpClicks'
        && hasExactly(request.resource.data, ['count', 'updatedAt'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.updatedAt == request.time;
      allow read, delete: if false;
    }

    match /stats/{doc} {
      allow read: if doc == 'summary';
      allow write: if false;
    }

    // Everything else is closed.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
