{
  "name": "sat-retake-advisor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run data:app",
    "build": "npm run check:data -- --quiet && npm run rules:check && npm run data:app && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run data:app && tsc -b",
    "test": "vitest run",
    "pretest": "npm run data:app",
    "test:watch": "vitest",
    "check:data": "tsx scripts/check-data.ts",
    "data:app": "tsx scripts/build-app-data.ts",
    "rules:build": "tsx scripts/build-rules.ts",
    "rules:check": "tsx scripts/build-rules.ts --check",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sat-retake-advisor \"vitest run -c vitest.rules.config.ts\"",
    "deploy:rules": "npm run rules:check && firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "lucide-react": "^1.80.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.10",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "firebase-tools": "^15.37.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    }
  }
}
