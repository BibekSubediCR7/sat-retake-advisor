{
  "name": "sat-retake-advisor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run data:app",
    "build": "npm run check:data && npm run data:app && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run data:app && tsc -b",
    "test": "vitest run",
    "pretest": "npm run data:app",
    "test:watch": "vitest",
    "check:data": "tsx scripts/check-data.ts",
    "data:app": "tsx scripts/build-app-data.ts"
  },
  "dependencies": {
    "lucide-react": "^1.80.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.10",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.1",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "zod": "^3.25.76"
  }
}
